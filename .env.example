# Brisbane Traffic Navigator - Environment Variables
# All variables are optional - the app will work with default/demo data

# Live traffic data API endpoint (optional)
# VITE_TRAFFIC_API_URL=https://your-traffic-api.com/data

# Custom map tile server (optional, defaults to OpenStreetMap)
# VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Directions API key for enhanced route features (optional)
# VITE_DIRECTIONS_API_KEY=your_api_key_here