#!/bin/sh
zero=0000000000000000000000000000000000000000
NAMES="main web-v1"
TAGP="refs/tags/v"
blocked=0
saw=0
while read lref lsha rref rsha
do
  saw=1
  for n in $NAMES; do
    [ "$rref" = "refs/heads/$n" ] && blocked=1
    [ "$lref" = "refs/heads/$n" ] && blocked=1
  done
  case "$rref" in
    $TAGP*) [ "$lsha" = "$zero" ] && blocked=1; [ "$rsha" != "$zero" ] && blocked=1;;
  esac
done
cur="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")"
for n in $NAMES; do
  [ "$cur" = "$n" ] && blocked=1
done
dest_ref="$(git rev-parse --symbolic-full-name @{push} 2>/dev/null || echo "")"
dest_branch="$(echo "$dest_ref" | sed -E 's#^refs/remotes/[^/]+/##')"
for n in $NAMES; do
  [ "$dest_branch" = "$n" ] && blocked=1
done
[ $blocked -eq 0 ] || { echo "❌ Push blocked: protected branch/tag"; exit 1; }
exit 0
