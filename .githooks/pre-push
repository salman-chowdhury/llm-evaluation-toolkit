#!/bin/sh
zero=0000000000000000000000000000000000000000
PROTECTED_BRANCHES="refs/heads/main refs/heads/web-v1"
PROTECTED_TAG_PREFIX="refs/tags/v"
saw_input=0
blocked=0
while read local_ref local_sha remote_ref remote_sha
do
  saw_input=1
  for pb in $PROTECTED_BRANCHES; do
    if [ "$remote_ref" = "$pb" ] || [ "$local_ref" = "$pb" ]; then
      echo "❌ Push touching protected branch ($remote_ref or $local_ref) is blocked. Use a feature branch + PR."
      blocked=1
    fi
  done
  case "$remote_ref" in
    $PROTECTED_TAG_PREFIX*)
      if [ "$local_sha" = "$zero" ]; then
        echo "❌ Deleting protected tag '${remote_ref#refs/tags/}' is blocked."
        blocked=1
      elif [ "$remote_sha" != "$zero" ]; then
        echo "❌ Updating protected tag '${remote_ref#refs/tags/}' is blocked (v* tags are immutable)."
        blocked=1
      fi
      ;;
  esac
done
current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")"
for pb in $PROTECTED_BRANCHES; do
  if [ "refs/heads/$current_branch" = "$pb" ]; then
    if [ $saw_input -eq 0 ]; then
      echo "❌ Push from protected current branch '$current_branch' is blocked."
      blocked=1
    fi
  fi
done
[ $blocked -eq 0 ] || exit 1
exit 0
