#!/bin/sh
zero=0000000000000000000000000000000000000000
PROTECTED_BRANCH_NAMES="main web-v1"
PROTECTED_TAG_PREFIX="refs/tags/v"

is_protected_ref () {
  ref="$1"
  for name in $PROTECTED_BRANCH_NAMES; do
    [ "$ref" = "refs/heads/$name" ] && return 0
    [ "$ref" = "$name" ] && return 0
  done
  return 1
}

blocked=0
saw_input=0
while read local_ref local_sha remote_ref remote_sha
do
  saw_input=1
  is_protected_ref "$local_ref" && blocked=1
  is_protected_ref "$remote_ref" && blocked=1
  case "$remote_ref" in
    $PROTECTED_TAG_PREFIX*)
      [ "$local_sha" = "$zero" ] && blocked=1
      [ "$remote_sha" != "$zero" ] && blocked=1
      ;;
  esac
done

current_branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || echo "")"
for name in $PROTECTED_BRANCH_NAMES; do
  [ "$current_branch" = "$name" ] && blocked=1
done

[ $blocked -eq 0 ] || { echo "❌ Push blocked: protected refs (main/web-v1) or protected tags (v*)"; exit 1; }
exit 0
